# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key

# Aliyun DashScope API Key — required for the Qwen-VL family used by
# `vision-analyst` (qwen-vl-plus-latest) and `ocr-extractor`
# (qwen-vl-ocr-latest). Without this, any chat that attaches an image
# will reach the routing prompt but the subagent's
# `create_chat_model("qwen-vl-...")` call fails at startup. The lead
# agent's <vision_routing>降级 path then surfaces "图片识别失败" to the
# user. One key serves both VL models. Get a key at
# https://dashscope.console.aliyun.com (阿里云百炼/DashScope).
DASHSCOPE_API_KEY=your-dashscope-api-key
# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Aliyun OSS — required when the `oss:` block is present in config.yaml.
# Both keys must be set or src.storage.get_default() raises at first use.
# ALIYUN_OSS_ACCESS_KEY_ID=
# ALIYUN_OSS_ACCESS_KEY_SECRET=
