# Production-style .env for deer-flow-mind backed by Aliyun KMS Secrets Manager.
#
# This file is for reference only — most production deploys won't ship a .env
# at all because every secret-bearing yaml field uses a kms:// reference and
# the host's RAM role grants access to KMS directly. The few entries below
# are the LLM / search-tool API keys that are still surfaced via env vars in
# config.yaml (`api_key: $OPENAI_API_KEY` etc); they're written as kms:// here
# so the env -> KMS indirection in src/config/app_config.py:resolve_env_variables
# kicks in and pulls the plaintext at startup.
#
# Local dev: do NOT use this file. Copy .env.example to .env and fill in
# plaintext values, leaving KMS_ENABLED=false.

# === KMS resolver knobs ===
KMS_ENABLED=true
KMS_REGION=cn-hangzhou
# KMS_ENDPOINT=kms.cn-hangzhou.aliyuncs.com   # default; override only for VPC endpoints
# KMS_CACHE_TTL_SECONDS=300                   # in-process plaintext cache TTL (default 5min)

# === LLM API keys (KMS-backed) ===
# Each value below is a kms:// reference. resolve_env_variables() detects
# the prefix and substitutes the plaintext fetched from KMS.
DASHSCOPE_API_KEY=kms://deerflow/dashscope-api-key
OPENAI_API_KEY=kms://deerflow/openai-api-key
ANTHROPIC_API_KEY=kms://deerflow/anthropic-api-key
DEEPSEEK_API_KEY=kms://deerflow/deepseek-api-key
GEMINI_API_KEY=kms://deerflow/gemini-api-key
GOOGLE_API_KEY=kms://deerflow/gemini-api-key
VOLCENGINE_API_KEY=kms://deerflow/volcengine-api-key
NOVITA_API_KEY=kms://deerflow/novita-api-key
MOONSHOT_API_KEY=kms://deerflow/moonshot-api-key

# === Search / web tool API keys (KMS-backed) ===
TAVILY_API_KEY=kms://deerflow/tavily-api-key
JINA_API_KEY=kms://deerflow/jina-api-key
INFOQUEST_API_KEY=kms://deerflow/infoquest-api-key
FIRECRAWL_API_KEY=kms://deerflow/firecrawl-api-key

# === Aliyun OSS AK/SK ===
# In production prefer setting these in config.yaml under `oss.access_key_id`
# / `oss.access_key_secret` as kms:// refs, and leave these env vars unset.
# Listed here for parity with the local .env.
# ALIYUN_OSS_ACCESS_KEY_ID=kms://deerflow/aliyun-oss-ak
# ALIYUN_OSS_ACCESS_KEY_SECRET=kms://deerflow/aliyun-oss-sk

# === IM / observability (NOT routed through KMS per ops decision) ===
# Keep these as plaintext or omit entirely. The decision to skip KMS for
# these scopes is intentional — see scripts/kms/README.md.
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# TELEGRAM_BOT_TOKEN=
# LANGSMITH_API_KEY=
